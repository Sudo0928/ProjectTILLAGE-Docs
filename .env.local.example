# Notion API 연동 (필수)
# Notion Integration Secret: https://www.notion.so/my-integrations
NOTION_TOKEN=

# 기획서 데이터베이스 ID (Notion DB URL에서 추출)
# 예: https://www.notion.so/myworkspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
#          → xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=

# 사이트 기본 URL — SEO 메타데이터 및 OG 절대 경로 생성용
# 로컬 개발 시 http://localhost:3000, 배포 시 실제 도메인으로 변경
NEXT_PUBLIC_SITE_URL=http://localhost:3000
